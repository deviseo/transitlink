{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TransitLink",
  "version": "0.4.0",
  "identifier": "com.deviseo.transitlink",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TransitLink",
        "width": 1120,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "transitlink"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3Njk2QkNFNDVEQzZDREEKUldUYWJOeEZ6bXRweC9OZ2VudnlLVVBaRXRmL2loVEppMGE4VEN5NWhrQXhDcGpjMWFiU0UwWXMK",
      "endpoints": [
        "https://github.com/deviseo/transitlink/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "中转站用户客户端",
    "longDescription": "登录中转站（new-api / sub2api），管理 Key，一键配置 Claude Code 与 Codex。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  }
}
